{
  "name": "arc-net",
  "version": "0.1.0",
  "description": "A Model Context Protocol (MCP) server for ChatGPT and compatible AI assistants",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "node --loader ts-node/esm src/index-http.ts",
    "dev:stdio": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index-http.js",
    "build": "tsc",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "typecheck": "bun run tsc --noEmit",
    "lint": "echo 'Linting not yet configured'"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "arc-raiders",
    "chatgpt"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "fuzzysort": "^3.1.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@netlify/functions": "^5.1.2",
    "@types/node": "^25.2.2",
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
